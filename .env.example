# Copy to `.env.local` before running signup/login Route Handlers against AWS Cognito.

# Region where the Cognito user pool exists (matches backend `sst.config.ts`).
AWS_REGION=us-east-2

# Profile the Next.js server uses for `@aws-sdk` (same CLI profile you SSO into).
AWS_PROFILE=zumo-dev

# Dashboard app client id (same UUID either way — pick one naming style).
COGNITO_USER_POOL_CLIENT_ID=
# NEXT_PUBLIC_COGNITO_CLIENT_ID=
