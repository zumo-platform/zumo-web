# Copy to `.env.local` before running signup/login Route Handlers against AWS Cognito.

# Base URL of the deployed SST API Gateway (no trailing slash). Set one of these; the server uses
# `API_URL` if present, otherwise `NEXT_PUBLIC_API_URL` (same value as in README / SST dashboard site).
API_URL=
NEXT_PUBLIC_API_URL=

# Region where the Cognito user pool exists (matches backend `sst.config.ts`).
AWS_REGION=us-east-2

# Profile the Next.js server uses for `@aws-sdk` (same CLI profile you SSO into).
AWS_PROFILE=zumo-dev

# Dashboard app client id (same UUID either way — pick one naming style).
COGNITO_USER_POOL_CLIENT_ID=
# NEXT_PUBLIC_COGNITO_CLIENT_ID=

# Meta Embedded Signup (Facebook Login for Business configuration id + app id).
# Local connect flow requires HTTPS — `pnpm dev` starts https://localhost:3000 automatically.
NEXT_PUBLIC_WHATSAPP_APP_ID=
NEXT_PUBLIC_WHATSAPP_ES_CONFIG_ID=

# Split hosting: marketing on Vercel (zumob2b.com), platform on AWS (app.zumob2b.com).
# Set on Vercel for the marketing deployment; set PLATFORM on AWS prod (can omit locally).
NEXT_PUBLIC_MARKETING_SITE_URL=https://zumob2b.com
NEXT_PUBLIC_PLATFORM_APP_URL=https://app.zumob2b.com
